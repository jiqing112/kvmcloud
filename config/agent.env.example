# kvmcloud-agent 配置（0600 权限，含凭据请勿提交版本库）
# 以下占位符由 install.sh 按部署形态注入
CONTROL_ADDR=__CONTROL_ADDR__
JOIN_TOKEN=__JOIN_TOKEN__
NODE_NAME=__NODE_NAME__

# 四维超开比（安装参数 --cpu-ratio 等覆盖）
CPU_RATIO=__CPU_RATIO__
MEM_RATIO=__MEM_RATIO__
DISK_RATIO=__DISK_RATIO__
BW_RATIO=__BW_RATIO__

# 物理网卡与速率（kbps）；留 0 自动探测 AGENT_NIC 速率
AGENT_NIC=eth0
AGENT_NIC_BANDWIDTH_KBPS=0

# 心跳周期
HEARTBEAT_INTERVAL=15s

# 建机任务：拉取周期 / 数据目录 / 基础镜像 / 桥接网口
# AGENT_BASE_IMAGE 必须是节点本地 qcow2 基础镜像（backing file，秒级克隆）；
# 未设置时建机任务会失败并在 UI 显示原因（status=error，容量自动回滚）。
PROVISION_INTERVAL=10s
AGENT_DATA_DIR=/var/lib/kvmcloud
#AGENT_BASE_IMAGE=/var/lib/kvmcloud/images/base.qcow2
AGENT_BRIDGE=virbr0

# 控制面 HTTP 地址（默认由 CONTROL_ADDR 推导为 http://<host>:8080，可覆盖）
#CONTROL_HTTP_ADDR=http://127.0.0.1:8080

# 内存回收：气球与 KSM（计算节点可选）
MEM_BALLOON_ENABLED=false
KSM_ENABLED=false

# 本体自动更新：auto=检测到新版本后台自更新（校验+原子替换+失败回滚）
# check=仅检测告警；off=关闭。通道 auto=gitee 优先回退 github。
#KC_AUTO_UPDATE=auto
#KC_UPDATE_CHANNEL=auto
#KC_UPDATE_INTERVAL=6h
#KC_UPDATE_JITTER=30m
